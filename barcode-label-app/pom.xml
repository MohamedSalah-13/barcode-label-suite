<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.mohamed.barcodelabel</groupId><artifactId>barcode-label-suite</artifactId><version>0.9.0</version></parent>
    <artifactId>barcode-label-app</artifactId>
    <repositories>
        <!-- Named so that it is asked first. A project's own repositories come before the inherited Central, and
             JitPack answers some coordinates it does not have (xml-apis:xml-apis-ext, for one) with an empty file
             instead of 404: Maven keeps the empty jar and a build with an empty local repository fails. -->
        <repository><id>central</id><url>https://repo.maven.apache.org/maven2</url><snapshots><enabled>false</enabled></snapshots></repository>
        <!-- Serves desktop-updater and app-icons straight from their GitHub tags; only the app needs them. -->
        <repository><id>jitpack.io</id><url>https://jitpack.io</url></repository>
    </repositories>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>barcode-label-fx-batch</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId></dependency>
        <dependency><groupId>org.kordamp.ikonli</groupId><artifactId>ikonli-javafx</artifactId></dependency>
        <dependency><groupId>org.kordamp.ikonli</groupId><artifactId>ikonli-feather-pack</artifactId></dependency>
        <!-- Offers new releases of the installed app and installs them (BarcodeLabelSuiteApp.start). -->
        <dependency><groupId>com.github.MohamedSalah-13</groupId><artifactId>desktop-updater</artifactId></dependency>
        <!-- Writes the icon files; only scripts/AppIcon.java uses it. Test scope keeps it out of the packaged app, and
             Maven still downloads the jar that script runs with. -->
        <dependency><groupId>com.github.MohamedSalah-13</groupId><artifactId>app-icons</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <!-- A version-free name, so packaging scripts need not know the version. -->
        <finalName>barcode-label-app</finalName>
        <plugins>
            <plugin><groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><configuration><mainClass>com.mohamed.barcodelabel.app.BarcodeLabelSuiteLauncher</mainClass></configuration></plugin>
        </plugins>
    </build>
</project>
